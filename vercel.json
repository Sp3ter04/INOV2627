{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/juri",
      "destination": "/index.html"
    },
    {
      "source": "/juri/",
      "destination": "/index.html"
    },
    {
      "source": "/coordenador",
      "destination": "/index.html"
    },
    {
      "source": "/coordenador/",
      "destination": "/index.html"
    },
    {
      "source": "/coordenador/juri",
      "destination": "/index.html"
    },
    {
      "source": "/coordenador/juri/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
